    {
      "poemId": 11,
      "grade": 5,
      "slug": "zheng-ren-mai-lu",
      "title": "鄭人買履",
      "author": "韓非",
      "sourceFile": "郑人买履只用前50s.mp3",
      "sourceSHA256": "c9b882a27ef916e71c114a8c8529b143699406d892012e470128de6ecb973fee",
      "sourceDurationSeconds": 129.792,
      "segments": {
        "title": {
          "text": "鄭人買履",
          "src": "media/recitations/round2-20261005/p11-title.mp3",
          "sourceStartSeconds": 2.3,
          "sourceEndSeconds": 4.73,
          "contentDurationSeconds": 2.43,
          "encodedDurationSeconds": 2.482,
          "bytes": 50200,
          "sha256": "25785ca1c1660f1a1aeb43560f8c4d16bea5e5db97e64a79a9bd90f35bfd6464"
        },
        "author": {
          "text": "韓非",
          "src": "media/recitations/round2-20261005/p11-author.mp3",
          "sourceStartSeconds": 6.22,
          "sourceEndSeconds": 8.51,
          "contentDurationSeconds": 2.29,
          "encodedDurationSeconds": 2.325,
          "bytes": 47065,
          "sha256": "b43276fb1e61043dc72f374b5b81e41e10a8e72ac71b6725a1c8fdcbc6681e25"
        },
        "line1": {
          "text": "鄭人有且置履者，先自度其足而置之其坐。",
          "src": "media/recitations/round2-20261005/p11-line1.mp3",
          "sourceStartSeconds": 12.44,
          "sourceEndSeconds": 19.51,
          "contentDurationSeconds": 7.07,
          "encodedDurationSeconds": 7.105,
          "bytes": 142673,
          "sha256": "4957af603ec61bdca312e8b6bf15754c083971b5d9eae7e34e489b9d86ee990a"
        },
        "line2": {
          "text": "至之市，而忘操之，已得履，乃曰：「吾忘持度。」",
          "src": "media/recitations/round2-20261005/p11-line2.mp3",
          "sourceStartSeconds": 20.88,
          "sourceEndSeconds": 29.67,
          "contentDurationSeconds": 8.79,
          "encodedDurationSeconds": 8.829,
          "bytes": 177155,
          "sha256": "483257574a5102c33d86f885b1855ab2ebec4ea8df8ba314e6650d0a730bef4f"
        },
        "line3": {
          "text": "反歸取之，及反，市罷，遂不得履。",
          "src": "media/recitations/round2-20261005/p11-line3.mp3",
          "sourceStartSeconds": 30.76,
          "sourceEndSeconds": 38.4,
          "contentDurationSeconds": 7.64,
          "encodedDurationSeconds": 7.68,
          "bytes": 154167,
          "sha256": "56293384374270fe9ae1055b7db37d78652f23938e365db31e387ae41c506e96"
        },
        "line4": {
          "text": "人曰：「何不試之以足？」曰：「寧信度，無自信也。」",
          "src": "media/recitations/round2-20261005/p11-line4.mp3",
          "sourceStartSeconds": 39.15,
          "sourceEndSeconds": 49.25,
          "contentDurationSeconds": 10.1,
          "encodedDurationSeconds": 10.136,
          "bytes": 203277,
          "sha256": "f1ef5821238196afbd3ea8c6edef9a10742c050ab96fccb96b45417e48a19f35"
        },
        "poem": {
          "text": "鄭人有且置履者，先自度其足而置之其坐。至之市，而忘操之，已得履，乃曰：「吾忘持度。」反歸取之，及反，市罷，遂不得履。人曰：「何不試之以足？」曰：「寧信度，無自信也。」",
          "src": "media/recitations/round2-20261005/p11-poem.mp3",
          "sourceStartSeconds": 12.44,
          "sourceEndSeconds": 49.25,
          "contentDurationSeconds": 36.81,
          "encodedDurationSeconds": 36.859,
          "bytes": 737743,
          "sha256": "cb1b9840451fd48505a9543c9471e3deb91418305588495cd6dc0aabc400e92b"
        }
      }
    },
