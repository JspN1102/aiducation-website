          "src": "media/recitations/round2-20261005/p8-line3.mp3",
          "sourceStartSeconds": 18.26,
          "sourceEndSeconds": 21.1,
          "contentDurationSeconds": 2.84,
          "encodedDurationSeconds": 2.873,
          "bytes": 58036,
          "sha256": "c581c1fe0c9bbdaa77f8905f1fc08f1767d64c08e15783f3a8b2c6532617fdd7"
        },
        "line4": {
          "text": "一叫千門萬戶開。",
          "src": "media/recitations/round2-20261005/p8-line4.mp3",
          "sourceStartSeconds": 21.87,
          "sourceEndSeconds": 25.41,
          "contentDurationSeconds": 3.54,
          "encodedDurationSeconds": 3.579,
          "bytes": 72143,
          "sha256": "632007faa28052d41b2e8c40bb51bc42b6ce527e5db8342f368437bf6bd08579"
        },
        "poem": {
          "text": "頭上紅冠不用裁，滿身雪白走將來。平生不敢輕言語，一叫千門萬戶開。",
          "src": "media/recitations/round2-20261005/p8-poem.mp3",
          "sourceStartSeconds": 10.09,
          "sourceEndSeconds": 25.41,
          "contentDurationSeconds": 15.32,
