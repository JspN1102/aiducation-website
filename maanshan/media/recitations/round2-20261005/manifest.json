        },
        "line1": {
          "text": "頭上紅冠不用裁，",
          "src": "media/recitations/round2-20261005/p8-line1.mp3",
          "sourceStartSeconds": 10.09,
          "sourceEndSeconds": 13.15,
          "contentDurationSeconds": 3.06,
