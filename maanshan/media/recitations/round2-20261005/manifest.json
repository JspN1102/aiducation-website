        },
        "line2": {
          "text": "滿身雪白走將來。",
          "src": "media/recitations/round2-20261005/p8-line2.mp3",
          "sourceStartSeconds": 14.16,
          "sourceEndSeconds": 17.15,
          "contentDurationSeconds": 2.99,
          "encodedDurationSeconds": 3.03,
          "bytes": 61171,
          "sha256": "566752c336d36aecb5b03ff581590c7e5f3f177a828d4f94f3b39572f42d48a6"
        },
        "line3": {
