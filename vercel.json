{
  "trailingSlash": true,
  "functions": {
    "api/soe.js": {
      "maxDuration": 30
    },
    "api/tts.js": {
      "maxDuration": 20
    },
    "api/maanshan-report.js": {
      "maxDuration": 60
    },
    "api/maanshan-chat.js": {
      "maxDuration": 30
    },
    "api/maanshan-save.js": {
      "maxDuration": 10
    },
    "api/maanshan-data.js": {
      "maxDuration": 15
    },
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/report.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/mandarin-assessment/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/mandarin-assessment/echarts.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/mandarin-assessment/:file*.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/mandarin-assessment/:file*.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/mandarin-assessment/:file*.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    },
    {
      "source": "/mandarin-assessment/china.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/maanshan/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/maanshan/media/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/maanshan/vendor/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/maanshan/media/:path*/model.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/awards/",
      "destination": "/awards/gesa-2026/",
      "permanent": false
    },
    {
      "source": "/maanshan/media/paper-crane-transparent.webp",
      "destination": "/maanshan/media/paper-crane-flight-v3.webp",
      "permanent": false
    },
    {
      "source": "/maanshan/media/paper-crane-v2.webp",
      "destination": "/maanshan/media/paper-crane-flight-v3.webp",
      "permanent": false
    }
  ]
}
