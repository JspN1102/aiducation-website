{
  "trailingSlash": true,
  "functions": {
    "api/maanshan-report.js": {
      "maxDuration": 60
    },
    "api/maanshan-chat.js": {
      "maxDuration": 30
    },
    "api/maanshan-save.js": {
      "maxDuration": 10
    },
    "api/maanshan-data.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/maanshan/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/maanshan/media/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/maanshan/vendor/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
