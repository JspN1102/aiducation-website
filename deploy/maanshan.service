[Unit]
Description=Maanshan Mandarin learning API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/maanshan/current
ExecStart=/usr/bin/node --env-file=/home/ubuntu/maanshan-shared/app.env /srv/maanshan/current/server/index.cjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077
LimitNOFILE=8192
MemoryMax=768M

[Install]
WantedBy=multi-user.target
