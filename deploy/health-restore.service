[Unit]
Description=Restore a Maanshan backup into an isolated disposable PostgreSQL cluster
After=maanshan-backup.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/python3 /usr/local/lib/maanshan-maintenance/health-restore.py
StateDirectory=maanshan-restore
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=360
TimeoutStopSec=20
KillMode=control-group
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=384M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/maanshan-restore
ReadOnlyPaths=/var/backups/maanshan
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LogRateLimitIntervalSec=1h
LogRateLimitBurst=4
StandardOutput=null
StandardError=null
